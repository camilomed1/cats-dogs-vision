# Copy this file to .env and edit it. .env is not uploaded to GitHub (it may contain the camera password).

# Camera to watch. Examples:
#   Tapo / RTSP camera:  rtsp://USER:PASSWORD@192.168.1.50:554/stream2   (stream1 = HD, stream2 = lower quality, faster)
#   HTTP MJPEG camera:   http://192.168.1.60:8080/video
#   Laptop webcam:       0
#   Video file (tests):  C:\path\to\video.mp4
CAMERA_URL=0
CAMERA_NAME=Laptop webcam

# Flask backend
API_URL=http://127.0.0.1:5000

# Port where this station serves the labeled video (/video) and its status (/status)
STATION_PORT=5001

# Detection events: save one snapshot when the same animal is seen with at least
# EVENT_CONFIDENCE in EVENT_FRAMES consecutive predictions (at most once every EVENT_COOLDOWN_S per animal)
EVENT_FRAMES=3
EVENT_CONFIDENCE=0.90
EVENT_COOLDOWN_S=15
PREDICT_EVERY_S=0.3

# MQTT: listens on MQTT_PREFIX/command for {"command": "SNAPSHOT"} (use the same values as the backend)
MQTT_ENABLED=true
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_PREFIX=catsdogs-vision/camilomed1
