# Copy to .env to override the defaults. Use the same broker and prefix as the backend and the camera station.
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_PREFIX=catsdogs-vision/camilomed1
DEVICE_NAME=virtual-ESP32
# If the network blocks port 1883: MQTT_TRANSPORT=websockets and MQTT_PORT=8083
MQTT_TRANSPORT=tcp
