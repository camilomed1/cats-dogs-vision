# Copy to .env to override the defaults
MONGO_URI=mongodb://localhost:27017
MONGO_DB=cats_dogs_vision
UNCERTAIN_THRESHOLD=0.80
MAX_IMAGE_MB=15
HOST=0.0.0.0
PORT=5000

# MQTT (stored predictions are published to MQTT_PREFIX/prediction)
MQTT_ENABLED=true
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_PREFIX=catsdogs-vision/camilomed1
# If the network blocks port 1883: MQTT_TRANSPORT=websockets and MQTT_PORT=8083
MQTT_TRANSPORT=tcp
